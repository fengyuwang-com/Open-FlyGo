# FlyGo control-plane env template (copy to .env, fill in, never commit).
# See README.md + DEPLOY-VPS.md. .env is gitignored (*.env).

# REQUIRED, >=16 chars. Service refuses to start without it.
# Generate: openssl rand -hex 32
FENGDOG_SECRET=

# Admin bootstrap token (management endpoints return 503 when empty).
FENGDOG_ADMIN_TOKEN=

# Optional (defaults shown).
FENGDOG_DB=./control-plane.db
FENGDOG_BIND=127.0.0.1
FENGDOG_PORT=9001
